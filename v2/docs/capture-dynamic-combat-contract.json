  },
  "spatial": {
    "movementExpected": true,
    "positioningExpected": true,
    "rangeExpected": true,
    "lineOfSightPolicy": "future_design_not_frozen",
    "usesNeutralSpatialCore": true,
    "mustNotUseRpgCombatState": true
  },
  "defense": {
    "dodgeOrPositioningExpected": true,
    "exactDodgeFormula": "future_design_not_frozen",
    "invulnerabilityFrames": "future_design_not_frozen"
  },
  "abilities": {
    "usesCaptureAbilityRuntime": true,
    "chargesPerOwnedInstance": true,
    "costsSupported": true,
    "cooldownsSupported": true,
    "rangeCanBeDefinedPerAbility": true,
    "exactCastTime": "future_design_not_frozen"
  },
  "capture": {
    "captureAttemptAllowedDuringWildBattle": true,
    "usesCaptureAttemptEngine": true,
    "speciesRateRequired": true,
    "orbCoefficientRequired": true,
    "lowHpBonusThresholdPercent": 30,
    "captureSuccessCreatesOwnedInstance": true,
    "overflowGoesToReserve": true
  },
  "aiAndPvp": {
    "vsAiSupported": true,
    "vsPlayerSupported": true,
    "aiDecisionModel": "future_design_not_frozen",
    "networkSyncModel": "future_design_not_frozen"
  },
  "nonGoalsForThisStage": [
    "final realtime tick rate",
    "final dodge formula",
